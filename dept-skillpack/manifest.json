  "auth": [
    {
      "id": "quectel-sso",
      "label": "Quectel SSO",
      "provider": "quectel-cli",
      "required": true,
      "covers": [
        "quectel-pms-query",
        "qpms-worktime"
      ],
      "check": {
        "bin": "quectel-cli",
        "args": [
          "status"
        ],
        "expect": "authenticated"
      },
      "hint": [
        "quectel-cli login --json        # 拿设备码，不会阻塞",
        "quectel-cli login --poll <device_code>   # 浏览器授权后回来轮询",
        "quectel-cli status             # 期望 authenticated",
        "# 换技能又被要求登录：先核对 QUECTEL_CLI_HOME 与 status 打印的凭据路径，别重复登录"
      ],
      "note": "禁止裸跑 `quectel-cli login`（会阻塞挂死约 10 分钟）。token 约一个月过期。一条根凭据同时覆盖 PMS 查询与工时填报——登录一次即可；换技能又被要求登录时，先核对 QUECTEL_CLI_HOME（status 会打印实际查找的凭据路径），别重复登录。"
    },
    {
      "id": "ms-graph",
      "label": "Microsoft 365（个人邮箱）",
      "provider": "msgraph-delegated-setup",
      "required": false,
      "covers": [
        "msgraph-delegated-setup"
      ],
      "check": {
        "bin": "python",
        "args": [
          "-c",
          "import msal, cryptography, requests"
        ],
        "expect": null,
        "failHint": "缺 Python 包（pip install msal cryptography requests）"
      },
      "hint": [
        "python <skills>/msgraph-delegated-setup/templates/auth_login.py --request",
        "# 浏览器打开 https://microsoft.com/devicelogin 输入 8 位码",
        "python <skills>/msgraph-delegated-setup/templates/auth_login.py --poll"
      ],
      "note": "共享公共 Client ID，各人各自授权；与 Quectel SSO 是两个独立身份源。"
    },
    {
      "id": "lark-cli",
      "label": "飞书开放能力",
      "provider": "lark-cli",
      "required": false,
      "covers": [],
      "check": {
        "bin": "lark-cli",
        "args": [
          "auth",
          "status"
        ],
        "expect": null
      },
      "hint": [
        "lark-cli auth login --domain base,docs"
      ],
      "note": "本包内暂无技能直接依赖；部分 lark-cli build 未内置 auth status，自检会报「无法自检」，属正常现象，本包技能不直接依赖它。"
    }
  ],
